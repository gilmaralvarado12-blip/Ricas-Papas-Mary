# General Django deployment configuration
DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1,https://your-app.onrender.com
SECURE_HSTS_SECONDS=31536000

# PostgreSQL configuration for local or hosting environments
POSTGRES_DB=ricapapas_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Optional: if you use Render, you can also set DATABASE_URL instead of individual POSTGRES_* values
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Google Maps API key (if needed for delivery checkout)
GOOGLE_MAPS_API_KEY=
